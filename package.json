{
  "name": "god-search",
  "version": "1.1.1",
  "description": "Multi-engine web search sidecar for agents — CloakBrowser + public APIs + MCP",
  "type": "module",
  "bin": {
    "god-search": "index.js"
  },
  "scripts": {
    "test": "npm run test:deterministic",
    "test:cache": "node test/verify-cache.js",
    "test:extraction": "node test/verify-extraction.js",
    "test:providers": "node test/verify-providers.js",
    "test:merger": "node test/verify-merger.js",
    "test:run-search": "node test/verify-run-search.js",
    "test:contracts": "node test/verify-contracts.js",
    "test:http": "node test/verify-http.js",
    "test:mcp": "node test/verify-mcp.js",
    "test:browser": "node test/verify-browser.js",
    "test:browser-engines": "node test/verify-browser-engines.js",
    "test:language": "node test/verify-language.js",
    "test:relevance": "node test/verify-relevance.js",
    "benchmark": "node benchmark/run.js --offline",
    "benchmark:no-key": "node benchmark/run.js --no-key",
    "benchmark:auto-label": "node benchmark/scripts/auto-label-qrels.js --pool benchmark/runs/latest-no-key/blind-judging-pool.jsonl --base benchmark/fixtures/qrels.tsv --out benchmark/runs/latest-no-key/qrels.auto.tsv --review benchmark/runs/latest-no-key/auto-label-review.jsonl",
    "benchmark:live": "node benchmark/run.js --live",
    "benchmark:all": "node benchmark/run.js --offline --live",
    "test:deterministic": "npm run test:cache && npm run test:extraction && npm run test:providers && npm run test:merger && npm run test:run-search && npm run test:contracts && npm run test:http && npm run test:mcp && npm run test:browser && npm run test:browser-engines && npm run test:language && npm run test:relevance",
    "test:live": "node test/verify-engines.js",
    "test:soak": "node test/soak-live.js",
    "prebuild": "node -e \"import('cloakbrowser').then(m => m.ensureBinary ? m.ensureBinary() : null).catch(()=>{})\"",
    "postversion": "node -e \"const fs=require('fs');const v=require('./package.json').version;const s=fs.readFileSync('SKILL.md','utf8').replace(/^version: .+$/m,'version: '+v);fs.writeFileSync('SKILL.md',s);console.log('SKILL.md updated to',v)\""
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cloakbrowser": "0.3.25",
    "playwright-core": "^1.59.1",
    "zod": "^3.22.0"
  }
}
